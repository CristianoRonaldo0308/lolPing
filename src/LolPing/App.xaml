<Application x:Class="LolPing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LolPing.Core"
             xmlns:ui="clr-namespace:LolPing.UI"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Bảng màu -->
            <SolidColorBrush x:Key="WindowBrush" Color="#171C2A"/>
            <SolidColorBrush x:Key="CardBrush" Color="#1F2537"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3147"/>
            <SolidColorBrush x:Key="TileBrush" Color="#141927"/>
            <SolidColorBrush x:Key="TileHoverBrush" Color="#1B2234"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E8ECF4"/>
            <SolidColorBrush x:Key="SubtextBrush" Color="#9AA3B8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#3D8BFF"/>
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#252C40"/>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Margin" Value="0,30,0,12"/>
            </Style>

            <Style x:Key="Subtext" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Width" Value="64"/>
            </Style>

            <!-- Hàng cài đặt: biểu tượng | tiêu đề + mô tả | điều khiển -->
            <Style TargetType="ui:SettingRow">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:SettingRow">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="20,14" MinHeight="76">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="{TemplateBinding Header}" FontSize="15" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Subtext}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Description" Value="{x:Null}">
                                    <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CheckBox dạng công tắc Bật/Tắt -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="OffText" Text="{c:Tr Off}" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="OnText" Text="{c:Tr On}" FontSize="15" Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <Border x:Name="Track" Width="48" Height="24" CornerRadius="12" BorderThickness="1.5"
                                        BorderBrush="#8A93A8" Background="Transparent">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#C9CFDC" HorizontalAlignment="Left" Margin="4,0"/>
                                </Border>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#C2C8D6"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="#0E1320"/>
                                    <Setter TargetName="Thumb" Property="Width" Value="18"/>
                                    <Setter TargetName="Thumb" Property="Height" Value="18"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="3,0"/>
                                    <Setter TargetName="OnText" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OffText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Thanh điều hướng bên trái -->
            <Style x:Key="NavList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0,2">
                                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="22,14">
                                                <ContentPresenter/>
                                            </Border>
                                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1E2435"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <Style x:Key="NavText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
