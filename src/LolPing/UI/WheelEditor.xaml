<UserControl x:Class="LolPing.UI.WheelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LolPing.Core">
    <Border Style="{StaticResource Card}" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="TitleText" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="DescText" Style="{StaticResource Subtext}" Margin="0,6,0,0" LineHeight="22"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Padding="16,8" Content="{c:Tr ResetDefaults}" Click="Reset_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="WheelHost" Width="440" Height="440" VerticalAlignment="Center" Margin="0,0,28,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PaletteTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{c:Tr PaletteDesc}" Style="{StaticResource Subtext}" Margin="0,4,0,10"/>
                    <Grid x:Name="FilterBar" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" FontSize="14" Padding="10,6" TextChanged="Filter_Changed"
                                 ToolTip="{c:Tr SearchHint}"/>
                        <ComboBox x:Name="FilterCombo" Grid.Column="1" Width="170" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Tag="all" Content="{c:Tr FilterAll}" IsSelected="True"/>
                            <ComboBoxItem Tag="clip" Content="{c:Tr FilterSounds}"/>
                            <ComboBoxItem Tag="image" Content="{c:Tr FilterImages}"/>
                            <ComboBoxItem Tag="builtin" Content="{c:Tr FilterBuiltin}"/>
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" AllowDrop="True" x:Name="PaletteFrame">
                        <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="Palette" Margin="4"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel x:Name="CustomBar" Margin="0,12,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <Button Padding="14,8" Margin="0,0,8,6" Click="AddSound_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{c:Tr AddSound}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="14,8" Margin="0,0,8,6" Click="AddImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{c:Tr AddImage}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="14,8" Margin="0,0,8,6" Click="StopSounds_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{c:Tr StopSounds}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="ImageCount" Style="{StaticResource Subtext}" Margin="0,4,0,0" FontSize="14"/>
                        <TextBlock Text="{c:Tr AddSoundHint}" Style="{StaticResource Subtext}" Margin="0,8,0,0"/>
                        <TextBlock Text="{c:Tr AddImageHint}" Style="{StaticResource Subtext}" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
